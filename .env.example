# TelecomLens configuration
# Copy this file to .env and edit as needed. All settings have safe defaults;
# you only need a .env to change them. See docs/SECURITY_HARDENING.md.

# ── Core ──────────────────────────────────────────────────────────────────────
# Database — SQLite (default) or any SQLAlchemy URL
DATABASE_URL=sqlite:///./telecomlens.db
# DATABASE_URL=postgresql://user:password@localhost:5432/telecomlens

# Folder to scan for batch bill imports (also the base that folder-imports are
# confined to — see IMPORT_BASE below).
BILLS_FOLDER=bills

# Windows: path to the Poppler bin folder containing pdftotext.exe
# Linux/macOS: leave blank — pdftotext is found via PATH
POPPLER_PATH=poppler

# ── Security (hardening) ──────────────────────────────────────────────────────
# Require a per-install token on every state-changing request. The dashboard
# injects it automatically; leave this ON. Turn off ONLY for throwaway local
# testing where nothing sensitive is loaded.
AUTH_ENABLED=true

# App token. Leave blank to auto-generate and persist to .telecomlens_secret
# (git-ignored, chmod 600). Set an explicit value to share one token across
# machines or to drive the API from your own scripts (send it in X-TL-Token).
# APP_TOKEN=

# Cross-origin browsers allowed to READ the API. Empty = same-origin only, which
# is the safe default and does NOT affect the dashboard itself. Only set this if
# a different web origin must call the API. "*" disables the protection — avoid.
CORS_ORIGINS=

# Host-header allow-list (blunts DNS-rebinding). localhost/127.0.0.1/::1 are
# always allowed. Add your LAN hostname or IP here for a shared install.
# TRUSTED_HOSTS=192.168.1.50

# Reject uploads larger than this many megabytes.
MAX_UPLOAD_MB=25

# Folder-import confinement. Imports are restricted to this directory (and its
# subfolders). Defaults to BILLS_FOLDER when blank.
# IMPORT_BASE=

# Outbound webhooks: block targets that resolve to private/loopback/link-local
# addresses (SSRF guard). Only enable private targets if you deliberately post
# to an internal service and understand the risk.
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOW_PRIVATE=false

# Emit security response headers (CSP, nosniff, frame-ancestors, …). Keep ON.
SECURITY_HEADERS=true
